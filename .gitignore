# Зависимости
node_modules/
package-lock.json

# Редакторы
.vscode/
.idea/

# .claude/ и .agents/ намеренно НЕ игнорируются: это скиллы агента,
# и они должны приезжать вместе с репозиторием. Весят ~2,7 МБ против
# 0,9 МБ самого сайта — если решите вынести их отдельно, добавьте сюда.

# Python-кеш (попадает из скиллов)
__pycache__/
*.py[cod]

# Системный мусор
.DS_Store
Thumbs.db

# Результаты прогонов тестов
test-results/
playwright-report/
*.log
